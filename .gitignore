# dependencies
node_modules/

# Expo
.expo/
.expo-shared/
dist/
web-build/
expo-env.d.ts

# Native projects (generated by prebuild / expo run:android|ios)
/ios
/android
.kotlin/
*.orig.*

# Signing keys and certificates
*.jks
*.p8
*.p12
*.key
*.pem
*.mobileprovision

# Build artifacts
*.apk
*.aab
*.ipa
/build/

# Native Firebase config (values are provided through EAS environment variables)
google-services.json
GoogleService-Info.plist

# Metro
.metro-health-check*

# Logs
*.log*
npm-debug.*
yarn-debug.*
yarn-error.*

# Environment variables
.env
.env.*
!.env.example

# TypeScript
*.tsbuildinfo

# OS and editors
.DS_Store
Thumbs.db
.idea/
*.iml
.vscode

# Local submission archive (regenerate from src/ when needed)
/src.zip
